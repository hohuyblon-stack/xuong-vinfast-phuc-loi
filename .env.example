# ============================================
# Xuong VinFast Phuc Loi - Cau hinh he thong
# Copy file nay thanh .env va dien gia tri
# ============================================

# --- Server ---
PORT=3000
NODE_ENV=production

# --- Zalo OA ---
# Lay Access Token tai: https://developers.zalo.me/app/{app_id}/oa
ZALO_ACCESS_TOKEN=your_zalo_oa_access_token
# Secret key de xac thuc webhook (tuy chon)
ZALO_OA_SECRET_KEY=

# --- Database (SQLite - mien phi, khong can API) ---
# Duong dan file SQLite. Mac dinh: ./data/xuong.db
DB_PATH=./data/xuong.db

# --- OCR (Tesseract - chay local, mien phi) ---
OCR_CONFIDENCE_HIGH=0.8
OCR_CONFIDENCE_MEDIUM=0.5

# --- Nguong canh bao thoi gian luu (gio) ---
ALERT_HOURS_WARNING=24
ALERT_HOURS_URGENT=48

# --- Quan ly ---
# Zalo user ID cua quan ly, cach nhau bang dau phay. De trong = tat thong bao.
MANAGER_CHAT_IDS=

# Gio gui bao cao tong hop tu dong (0-23, mac dinh: 18 = 6PM)
DAILY_REPORT_HOUR=18

# --- Timezone ---
TIMEZONE=Asia/Ho_Chi_Minh
