# ============================================
# Xuong VinFast Phuc Loi - Cau hinh he thong
# Copy file nay thanh .env va dien gia tri
# ============================================

# --- Server ---
PORT=3000
NODE_ENV=production

# --- Telegram Bot ---
# Tao bot qua @BotFather tren Telegram, lay token
TELEGRAM_BOT_TOKEN=123456789:ABCdefGHIjklMNOpqrsTUVwxyz

# URL cua server (de tu dong set webhook). De trong neu dung polling.
# VD: https://your-app.onrender.com
TELEGRAM_WEBHOOK_URL=

# --- Google Sheets ---
# ID cua Google Sheet (lay tu URL: https://docs.google.com/spreadsheets/d/{SHEET_ID}/edit)
GOOGLE_SHEET_ID=your_google_sheet_id

# Credentials dang JSON string (Service Account)
# Cach lay: Google Cloud Console > IAM > Service Accounts > Keys > JSON
GOOGLE_CREDENTIALS_JSON={"type":"service_account","project_id":"...","private_key":"...","client_email":"..."}

# --- Google Cloud Vision (OCR) ---
# Dung chung credentials voi Google Sheets neu cung project
# Neu de trong se dung GOOGLE_CREDENTIALS_JSON
GOOGLE_VISION_CREDENTIALS_JSON=

# --- Nguong OCR ---
OCR_CONFIDENCE_HIGH=0.8
OCR_CONFIDENCE_MEDIUM=0.5

# --- Luu tru tu dong ---
# Xe da RA qua bao nhieu gio thi tu dong chuyen sang tab LUU TRU (mac dinh: 24)
ARCHIVE_AFTER_HOURS=24

# --- Timezone ---
TIMEZONE=Asia/Ho_Chi_Minh
