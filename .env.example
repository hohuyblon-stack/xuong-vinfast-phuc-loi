# ============================================
# Xưởng VinFast Phúc Lợi - Cấu hình hệ thống
# Copy file này thành .env và điền giá trị
# ============================================

# --- Server ---
PORT=3000
NODE_ENV=production

# --- Zalo OA ---
ZALO_OA_ACCESS_TOKEN=your_zalo_oa_access_token
ZALO_OA_SECRET_KEY=your_zalo_oa_secret_key
ZALO_WEBHOOK_VERIFY_TOKEN=your_custom_verify_token

# --- Google Sheets ---
# ID của Google Sheet (lấy từ URL: https://docs.google.com/spreadsheets/d/{SHEET_ID}/edit)
GOOGLE_SHEET_ID=your_google_sheet_id

# Credentials dạng JSON string (Service Account)
# Cách lấy: Google Cloud Console > IAM > Service Accounts > Keys > JSON
GOOGLE_CREDENTIALS_JSON={"type":"service_account","project_id":"...","private_key":"...","client_email":"..."}

# --- Google Cloud Vision (OCR) ---
# Dùng chung credentials với Google Sheets nếu cùng project, hoặc tách riêng
# Nếu để trống sẽ dùng GOOGLE_CREDENTIALS_JSON
GOOGLE_VISION_CREDENTIALS_JSON=

# --- Ngưỡng OCR ---
# Confidence >= HIGH -> "Rõ"
OCR_CONFIDENCE_HIGH=0.8
# Confidence >= MEDIUM -> "Tạm được"
OCR_CONFIDENCE_MEDIUM=0.5
# Confidence < MEDIUM -> "Mờ / không chắc"

# --- Ngưỡng cảnh báo thời gian lưu (giờ) ---
# Quá ALERT_HOURS_WARNING -> Mức ưu tiên = "Cảnh báo"
ALERT_HOURS_WARNING=4
# Quá ALERT_HOURS_URGENT -> Mức ưu tiên = "Khẩn"
ALERT_HOURS_URGENT=8

# --- Timezone ---
TIMEZONE=Asia/Ho_Chi_Minh
