# ============================================================
# ENVIRONMENT CONFIGURATION TEMPLATE
# Xuong VinFast Phuc Loi Bot - Complete Setup
# ============================================================
# 1. Copy this file to .env
# 2. Fill in all YOUR_* values
# 3. NEVER commit .env to git (contains secrets)
# 4. Reference: SETUP_GUIDE.md for detailed instructions
# ============================================================

# ═══════════════════════════════════════════════════════════
# Server Configuration
# ═══════════════════════════════════════════════════════════
PORT=3000
NODE_ENV=production

# ═══════════════════════════════════════════════════════════
# Telegram Bot Configuration
# ═══════════════════════════════════════════════════════════
# 1. Create bot at https://t.me/BotFather
# 2. Copy token (format: 123456789:ABCdefGHIjklMNOpqrsTUVwxyz)
TELEGRAM_BOT_TOKEN=YOUR_BOT_TOKEN_HERE

# URL of your deployed server (webhook)
# Example: https://xuong-vinfast-bot.onrender.com
# Set AFTER deployment, webhook will auto-configure
TELEGRAM_WEBHOOK_URL=YOUR_SERVER_URL_HERE

# ═══════════════════════════════════════════════════════════
# Supabase PostgreSQL Configuration (SOURCE OF TRUTH)
# ═══════════════════════════════════════════════════════════
# 1. Create free account at https://supabase.com
# 2. Create new project
# 3. Run migrations from supabase/migrations/001-init-schema.sql
# 4. Go to Settings > API to get:

# Project URL
# Format: https://xxxxx.supabase.co
SUPABASE_URL=YOUR_SUPABASE_URL_HERE

# Service Role Key (has admin access - KEEP SECRET!)
# WARNING: Never commit this to git
SUPABASE_SERVICE_KEY=YOUR_SERVICE_ROLE_KEY_HERE

# ═══════════════════════════════════════════════════════════
# Google Sheets Configuration (READ-ONLY MIRROR)
# ═══════════════════════════════════════════════════════════
# Sheets is updated asynchronously from Supabase
# This is a reference copy for human viewing only

# Sheet ID from URL: https://docs.google.com/spreadsheets/d/{SHEET_ID}/edit
GOOGLE_SHEET_ID=YOUR_SHEET_ID_HERE

# Service Account JSON Credentials (for Sheets API access)
# Steps:
#   1. Go to https://console.cloud.google.com
#   2. Create Service Account (see SETUP_GUIDE.md for details)
#   3. Create JSON Key
#   4. Copy ENTIRE JSON content (from { to })
#   5. Share Google Sheet with service account email (Editor role)
# WARNING: This contains private key, keep it secret!
GOOGLE_CREDENTIALS_JSON={"type":"service_account","project_id":"YOUR_PROJECT_ID","private_key":"-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n","client_email":"xuong-vinfast-bot@YOUR_PROJECT_ID.iam.gserviceaccount.com","client_id":"...","auth_uri":"...","token_uri":"...","auth_provider_x509_cert_url":"...","client_x509_cert_url":"..."}

# Optional: Separate Vision API credentials (if different project)
# If empty, will use GOOGLE_CREDENTIALS_JSON
GOOGLE_VISION_CREDENTIALS_JSON=

# ═══════════════════════════════════════════════════════════
# OCR Settings (Google Cloud Vision)
# ═══════════════════════════════════════════════════════════
# Confidence threshold for "HIGH" confidence (0-1.0)
# Default 0.8 = 80% confident
OCR_CONFIDENCE_HIGH=0.8

# Confidence threshold for "MEDIUM" confidence (0-1.0)
# Default 0.5 = 50% confident
OCR_CONFIDENCE_MEDIUM=0.5

# ═══════════════════════════════════════════════════════════
# Alert Settings
# ═══════════════════════════════════════════════════════════
# Minimum time in workshop before allowing RA (minutes)
# Prevents false RA from burst photos
# Default: 3 minutes (avoids duplicate photos from fast camera bursts)
MIN_WORKSHOP_MINUTES=3

# Hours before marking vehicle as WARNING (yellow alert)
# Default: 24 hours
ALERT_HOURS_WARNING=24

# Hours before marking vehicle as URGENT (red alert)
# Default: 48 hours
ALERT_HOURS_URGENT=48

# ═══════════════════════════════════════════════════════════
# Manager Notifications
# ═══════════════════════════════════════════════════════════
# Telegram Chat IDs of managers (receive alerts)
# How to get: Send /start to @userinfobot on Telegram
# Format: comma-separated, no spaces
# Example: MANAGER_CHAT_IDS=123456789,987654321
# Leave empty to disable manager alerts
MANAGER_CHAT_IDS=

# Hour to send daily summary report (0-23, 18 = 6PM)
DAILY_REPORT_HOUR=18

# ═══════════════════════════════════════════════════════════
# Timezone
# ═══════════════════════════════════════════════════════════
# See: https://en.wikipedia.org/wiki/List_of_tz_database_time_zones
# Default: Asia/Ho_Chi_Minh (UTC+7)
TIMEZONE=Asia/Ho_Chi_Minh

# ═══════════════════════════════════════════════════════════
# Optional: OpenClaw Risk Manager
# ═══════════════════════════════════════════════════════════
# URL của server (dùng cho health check). Mặc định = TELEGRAM_WEBHOOK_URL
# OPENCLAW_SERVER_URL=https://xuong-vinfast-bot.onrender.com

# Cron schedules (mặc định đã tối ưu, chỉ đổi nếu cần)
# OPENCLAW_CRON_SERVER=*/5 * * * *     # Server check mỗi 5 phút
# OPENCLAW_CRON_DB=*/15 * * * *        # DB check mỗi 15 phút
# OPENCLAW_CRON_OCR=0 * * * *          # OCR check mỗi giờ
# OPENCLAW_CRON_DATA=0 */4 * * *       # Data anomaly mỗi 4 giờ
# OPENCLAW_CRON_DAILY=0 20 * * *       # Daily report lúc 20:00

# Thresholds
# OPENCLAW_ORPHAN_DAYS=7               # Xe > N ngày = orphan
# OPENCLAW_OCR_MIN_SUCCESS=0.8         # OCR success rate tối thiểu

# ═══════════════════════════════════════════════════════════
# Security Checklist (before deployment)
# ═══════════════════════════════════════════════════════════
# ⚠️ CRITICAL: Before committing or deploying:
# [ ] Never add .env file to git (add to .gitignore)
# [ ] Supabase Service Key = SECRET (keep local only)
# [ ] Google credentials JSON = SECRET (keep local only)
# [ ] Telegram bot token = SECRET (keep local only)
# [ ] Use .env.template for public template (no secrets)
# [ ] Set all secrets in production platform (Render/Railway/VPS)
# ═══════════════════════════════════════════════════════════
